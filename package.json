{
  "name": "dsh-importer",
  "version": "1.0.0",
  "description": "DSH plugin: sync chat.deepseek.com sessions into DSH as context — settings page, auto sync, per-session fetch, and a 'send' button that stages a file-reference prompt into the composer.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "node --check lib/index.js && node --check lib/client.js"
  },
  "license": "MIT"
}
